{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonofsurya.com/data/equipment.schema.json",
  "title": "Surya Design Studio equipment record",
  "description": "One PV module, inverter or battery in the Surya Design Studio library. Community submissions are reviewed before they are published.",
  "type": "object",
  "required": [
    "kind",
    "spec"
  ],
  "properties": {
    "kind": {
      "enum": [
        "module",
        "inverter",
        "battery"
      ]
    },
    "spec": {
      "type": "object"
    },
    "status": {
      "enum": [
        "Pending",
        "Published",
        "Rejected"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "module"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "inverter"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/inverter"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "battery"
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/battery"
          }
        }
      }
    }
  ],
  "$defs": {
    "module": {
      "type": "object",
      "required": [
        "id",
        "name",
        "manufacturer",
        "model",
        "wp",
        "length",
        "width",
        "voc",
        "vmp",
        "isc",
        "imp",
        "tcVoc",
        "tcPmax",
        "noct"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,40}$"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "manufacturer": {
          "type": "string",
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "datasheetUrl": {
          "type": "string",
          "format": "uri"
        },
        "origin": {
          "enum": [
            "builtin",
            "community",
            "mine"
          ]
        },
        "wp": {
          "description": "Maximum power at STC, W",
          "type": "number",
          "minimum": 50,
          "maximum": 900
        },
        "length": {
          "description": "m",
          "type": "number",
          "minimum": 0.8,
          "maximum": 2.6
        },
        "width": {
          "description": "m",
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.4
        },
        "voc": {
          "description": "Open-circuit voltage at STC, V",
          "type": "number",
          "minimum": 10,
          "maximum": 120
        },
        "vmp": {
          "description": "Voltage at maximum power, V",
          "type": "number",
          "minimum": 8,
          "maximum": 110
        },
        "isc": {
          "description": "Short-circuit current, A",
          "type": "number",
          "minimum": 1,
          "maximum": 25
        },
        "imp": {
          "description": "Current at maximum power, A",
          "type": "number",
          "minimum": 1,
          "maximum": 24
        },
        "tcVoc": {
          "description": "Voc temperature coefficient, %/degC",
          "type": "number",
          "minimum": -0.45,
          "maximum": -0.15
        },
        "tcPmax": {
          "description": "Pmax temperature coefficient, %/degC",
          "type": "number",
          "minimum": -0.55,
          "maximum": -0.2
        },
        "noct": {
          "description": "NOCT or NMOT, degC",
          "type": "number",
          "minimum": 38,
          "maximum": 52
        },
        "bifacial": {
          "type": "boolean"
        }
      }
    },
    "inverter": {
      "type": "object",
      "required": [
        "id",
        "name",
        "manufacturer",
        "model",
        "acKw",
        "maxDcV",
        "mpptMin",
        "mpptMax",
        "startV",
        "mppts",
        "maxIscPerMppt",
        "phase",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,40}$"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "manufacturer": {
          "type": "string",
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "datasheetUrl": {
          "type": "string",
          "format": "uri"
        },
        "origin": {
          "enum": [
            "builtin",
            "community",
            "mine"
          ]
        },
        "acKw": {
          "description": "Rated AC power, kW",
          "type": "number",
          "minimum": 0.5,
          "maximum": 350
        },
        "maxDcV": {
          "description": "V",
          "type": "number",
          "minimum": 100,
          "maximum": 1500
        },
        "mpptMin": {
          "description": "V",
          "type": "number",
          "minimum": 20,
          "maximum": 1200
        },
        "mpptMax": {
          "description": "V",
          "type": "number",
          "minimum": 50,
          "maximum": 1500
        },
        "startV": {
          "description": "V",
          "type": "number",
          "minimum": 20,
          "maximum": 1000
        },
        "mppts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "stringsPerMppt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "maxIscPerMppt": {
          "description": "A",
          "type": "number",
          "minimum": 5,
          "maximum": 120
        },
        "maxImpPerMppt": {
          "description": "A",
          "type": "number",
          "minimum": 5,
          "maximum": 120
        },
        "efficiency": {
          "description": "Weighted (EU/CEC) efficiency, %",
          "type": "number",
          "minimum": 90,
          "maximum": 99.5
        },
        "phase": {
          "enum": [
            1,
            3
          ]
        },
        "type": {
          "enum": [
            "ongrid",
            "hybrid"
          ]
        }
      }
    },
    "battery": {
      "type": "object",
      "required": [
        "id",
        "name",
        "manufacturer",
        "model",
        "chemistry",
        "usableKwh",
        "nominalV",
        "maxChargeKw",
        "maxDischargeKw",
        "roundTrip",
        "cycles",
        "warrantyYears"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,40}$"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "manufacturer": {
          "type": "string",
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "datasheetUrl": {
          "type": "string",
          "format": "uri"
        },
        "origin": {
          "enum": [
            "builtin",
            "community",
            "mine"
          ]
        },
        "chemistry": {
          "enum": [
            "LFP",
            "NMC",
            "Lead-acid",
            "Other"
          ]
        },
        "usableKwh": {
          "description": "kWh",
          "type": "number",
          "minimum": 0.5,
          "maximum": 1000
        },
        "nominalV": {
          "description": "V",
          "type": "number",
          "minimum": 12,
          "maximum": 1000
        },
        "maxChargeKw": {
          "description": "kW",
          "type": "number",
          "minimum": 0.2,
          "maximum": 500
        },
        "maxDischargeKw": {
          "description": "kW",
          "type": "number",
          "minimum": 0.2,
          "maximum": 500
        },
        "roundTrip": {
          "description": "%",
          "type": "number",
          "minimum": 70,
          "maximum": 99
        },
        "cycles": {
          "type": "integer",
          "minimum": 300,
          "maximum": 20000
        },
        "warrantyYears": {
          "description": "years",
          "type": "number",
          "minimum": 0,
          "maximum": 25
        }
      }
    }
  }
}